#!/bin/bash
set -e

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
runtime_dir="$data_home/Septabee/llvm-stuffs/abi-8"
mkdir -p "$runtime_dir"
# Keep an existing runtime installed by the app; seed fresh or incomplete setups.
if [[ ! -s "$runtime_dir/libseptabee-jit-runtime.so" || ! -s "$runtime_dir/runtime-release" ]]; then
  install -m644 /usr/lib/septabee/jit-runtime/libseptabee-jit-runtime.so "$runtime_dir/"
  install -m644 /usr/lib/septabee/jit-runtime/runtime-release "$runtime_dir/"
fi
cd /usr/lib/septabee
exec ./septabee "$@"
